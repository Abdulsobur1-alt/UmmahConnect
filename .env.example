# ── NEON DATABASE ──
# Get from: Neon Dashboard → Project → Connection Details
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── CLERK AUTH ──
# Get from: Clerk Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_SECRET_KEY=sk_live_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Clerk redirect URLs (defaults for this app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/feed
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/feed

# ── PAYSTACK PAYMENTS ──
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_live_xxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxx

# ── PUSHER (Realtime) ──
# Get from: Pusher Dashboard → App Keys
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
PUSHER_APP_ID=
PUSHER_SECRET=

# ── CLOUDFLARE R2 (File Storage) ──
# Get from: Cloudflare Dashboard → R2 → Bucket Settings
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── APP CONFIG ──
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SECURITY ──
# Generate with: openssl rand -base64 32
CRON_SECRET=
